 struct corten_arena corten_va_reserve_sentinel;
+
+/* ------------------------------------------------------------------ *
+ * W-7: the multi-record registry slot (D34 closure).
+ *
+ * A 2M frame's slot names the record set covering the frame: a bare
+ * struct corten_arena * while one record claims it, a tagged
+ * corten_frame_bucket pointer once page-disjoint records share the
+ * frame (the ELF load image shape: r--/r-x/rw- segment tails and
+ * heads inside one PMD), the reserve sentinel for magazine frames.
+ * Invariant INV2' (the page-level successor of the single-record
+ * era's frame exclusivity): two live records of one mm never overlap
+ * in PAGE range; frame overlap is legal exactly under that condition
+ * and is what a bucket records.  INV2' is established at the three
+ * insert sites (DECLARE/adopt, fork-child mirror) by
+ * corten_arena_overlaps()'s per-member page-range test -- the C1
+ * equivalent.
+ *
+ * Window-domain records are structurally unbucketable: a magazine or
+ * pool window's page domain is its whole frames (a partial co-tenant
+ * would page-overlap and C1' rejects it), and the sentinel claims
+ * whole frames.  Buckets only ever form in the legacy domain, between
+ * page-granular records (adopted segments, the brk region).
+ *
+ * The slot decodes ONLY through the helpers below -- every reader of
+ * a slot value in this file goes through corten_slot_arena() /
+ * corten_slot_cover() / corten_slot_has() / the bucket form, never
+ * through a raw xa_load() cast (a tagged pointer dereferenced as a
+ * descriptor is a random crash).
+ * ------------------------------------------------------------------
+ */
+
+/* The shared-frame member set: sorted by @rec[i]->start, RCU-freed
+ * (lookups run lockless), copy-updated on every membership change
+ * (writers hold mmap_write; declare/release/fork hold ctl_lock too --
+ * the same serialization the single-record stores ran under).
+ */
+struct corten_frame_bucket {
+	unsigned int		nr;	/* member count */
+	struct rcu_head		rcu;
+	struct corten_arena	*rec[] __counted_by(nr);
+};
+
+#define CORTEN_SLOT_BUCKET_TAG	1UL
+
+/* The bucket form of a slot value, or NULL. */
+static inline struct corten_frame_bucket *corten_slot_bucket(void *slot)
+{
+	if (!xa_pointer_tag(slot))
+		return NULL;
+	return xa_untag_pointer(slot);
+}
+
+/* The slot's single record, or NULL when the slot is a bucket, a
+ * reserve marker or empty.  This is the decode for every consumer
+ * whose contract is "the frame is exclusively this record" (park
+ * parkability, the magazine obstacle scans): a bucket in such a frame
+ * is an INV2-window-domain violation and must read as "no single
+ * owner", never as a dereference.
+ */
+static inline struct corten_arena *corten_slot_arena(void *slot)
+{
+	if (!slot || xa_pointer_tag(slot))
+		return NULL;
+	if (slot == &corten_va_reserve_sentinel)
+		return NULL;
+	return slot;
+}
+
+/* The record covering @addr, or NULL.  W-7: the resolution is
+ * page-granular for every slot form -- a single record answers only
+ * inside its recorded range, a bucket only the member covering @addr
+ * (co-frame records are page-disjoint, so a miss is a genuine hole: an
+ * unclaimed tail between two segments, a punched prefix -- the punch
+ * route's head-shrink re-anchors the record past it -- and the
+ * caller's fallback is the correct verdict).  The pre-W-7 form answered
+ * frame-granular and left the range bound to each caller's own
+ * [start,end) check; those checks (fault_owned tier 1, the route
+ * classifiers) stay as the transaction-seal defense.  Parked (idle)
+ * records are lookup-invisible (T1c).
+ */
+static inline struct corten_arena *corten_slot_cover(void *slot,
+						     unsigned long addr)
+{
+	struct corten_frame_bucket *b;
+	struct corten_arena *ar;
+	unsigned int i;
+
+	if (!slot)
+		return NULL;
+	b = corten_slot_bucket(slot);
+	if (!b) {
+		if (slot == &corten_va_reserve_sentinel)
+			return NULL;
+		ar = slot;
+		if (addr < READ_ONCE(ar->start) || addr >= READ_ONCE(ar->end))
+			return NULL;
+	} else {
+		ar = NULL;
+		for (i = 0; i < b->nr; i++) {
+			struct corten_arena *m = READ_ONCE(b->rec[i]);
+
+			if (READ_ONCE(m->idle))
+				continue;
+			if (addr >= READ_ONCE(m->start) &&
+			    addr < READ_ONCE(m->end)) {
+				ar = m;
+				break;
+			}
+		}
+		if (!ar)
+			return NULL;
+	}
+	if (READ_ONCE(ar->idle))
+		return NULL;
+	return ar;
+}
+
+/* Does the slot's member set contain @ar?  The [F-A] tier-2 / [F-B
+ * seal] / sweep-ownership decode: "frame f still belongs to @ar".
+ */
+static inline bool corten_slot_has(void *slot, const struct corten_arena *ar)
+{
+	struct corten_frame_bucket *b;
+	unsigned int i;
+
+	if (slot == ar)
+		return true;
+	b = corten_slot_bucket(slot);
+	if (!b)
+		return false;
+	for (i = 0; i < b->nr; i++)
+		if (READ_ONCE(b->rec[i]) == ar)
+			return true;
+	return false;
+}
+
+/* The member of @frame's slot whose recorded extent starts exactly at
+ * @start -- the RELEASE / pool-release / brk-region lookup decode (the
+ * single-record era read the slot bare).  Caller holds the registry
+ * writer locks or rcu_read_lock().
+ */
+static struct corten_arena *corten_slot_by_start(struct xarray *xa,
+						 unsigned long frame,
+						 unsigned long start)
+{
+	void *slot = xa_load(xa, frame);
+	struct corten_frame_bucket *b = corten_slot_bucket(slot);
+	unsigned int n, i;
+
+	n = b ? b->nr : 1;
+	for (i = 0; i < n; i++) {
+		struct corten_arena *m = b ? READ_ONCE(b->rec[i]) :
+					     corten_slot_arena(slot);
+
+		if (m && READ_ONCE(m->start) == start)
+			return m;
+	}
+	return NULL;
+}
+
+/* The registry's R1 walk cursor (see corten_registry_next()).  The
+ * public struct corten_region_iter carries the same fields -- the
+ * /proc row stream embeds it by value, so one shape serves both.
+ */
+
+/* Produce the next live record of @state's registry, ascending by
+ * [start), each exactly once.  The R1 rule (W-7): a record is emitted
+ * at the first frame of its span the walk can still see --
+ *
+ *   emit @m at frame F  iff  this is the walk's first examined frame
+ *     (the seeded mid-registry walks: the row stream's
+ *     covering-or-next seed must surface the straddling record)
+ *     or F is @m's start frame
+ *     or @m's start-frame slot no longer contains @m (a head punch
+ *     erased it -- @F is the first surviving slot).
+ *
+ * The third clause is what keeps a punched-span record emitted once:
+ * a mid-span punch leaves the start frame intact, so the record
+ * re-surfacing after the hole is recognized as already-emitted, while
+ * a head punch (start slot gone) re-anchors the emission at the first
+ * survivor -- the same semantics the single-record era's consecutive
+ * pointer dedupe grew into.  A bucket frame emits its due members in
+ * [start) order.  Stateless beyond the cursor -- the single-record era
+ * keyed its per-arena frame walks on computed "one past the last
+ * frame" cursors, and the r07 guest mm_exit stall (a mis-counted
+ * cursor re-draining a live descriptor) is exactly the failure class
+ * the rule removes.
+ *
+ * Locking: the caller's fence -- rcu_read_lock(), mmap_read (writers
+ * excluded, buckets are copy-updated) or mmap_write.  Reserve markers
+ * are skipped.  Returns NULL when the walk is exhausted (and resets
+ * the cursor).
+ */
+static struct corten_arena *corten_registry_next(struct corten_mm_state *state,
+						 struct corten_region_iter *it)
+{
+	for (;;) {
+		void *slot;
+		struct corten_frame_bucket *b;
+		struct corten_arena *ar = NULL;
+		unsigned long prev = it->frame;
+		bool first_at_frame;
+		unsigned int n;
+
+		slot = xa_find(&state->arenas, &it->frame, ULONG_MAX,
+			       XA_PRESENT);
+		if (!slot) {
+			it->frame = 0;
+			it->idx = 0;
+			it->last = NULL;
+			return NULL;
+		}
+		/* Frames strictly below the found index that the find
+		 * jumped were empty; a record surfacing after the jump
+		 * has its lower slots erased (or the walk was just
+		 * seeded mid-registry).
+		 */
+		first_at_frame = it->fresh || it->frame > prev;
+		it->fresh = false;
+
+		b = corten_slot_bucket(slot);
+		n = b ? b->nr : 1;
+		while (it->idx < n) {
+			ar = b ? READ_ONCE(b->rec[it->idx]) :
+				 corten_slot_arena(slot);
+			it->idx++;
+			if (!ar)
+				continue;
+			if ((ar->start >> PMD_SHIFT) == it->frame)
+				break;			/* start frame */
+			if (first_at_frame)
+				break;			/* seed / survivor */
+			if (!corten_slot_has(xa_load(&state->arenas,
+						     ar->start >> PMD_SHIFT),
+					     ar))
+				break;			/* head-punched */
+			ar = NULL;			/* continuation */
+		}
+		if (ar) {
+			it->last = ar;
+			return ar;
+		}
+		it->frame++;
+		it->idx = 0;
+	}
+}
+
+/* Add @ar to @frame's member set (the DECLARE/fork-child publish).
+ * A bucket change is a copy-update: the previous bucket dies by
+ * kfree_rcu() after the tagged store publishes the new one.  An empty
+ * frame takes its first member plain; a marker frame is overwritten
+ * plain -- the magazine-serve transition (the handed-out frames' arena
+ * covers their whole page domain, so no bucket can form there).  A
+ * single-record slot always forms a bucket: the new record passed C1',
+ * so the two are page-disjoint co-tenants.  Callers hold the registry
+ * writer locks.  Returns the xa_store status (0 or -errno).
+ */
+static int corten_slot_insert(struct xarray *xa, unsigned long frame,
+			      struct corten_arena *ar)
+{
+	struct corten_frame_bucket *b, *nb;
+	void *old = xa_load(xa, frame);
+	bool placed = false;
+	unsigned int n, i, j;
+	int ret;
+
+	if (WARN_ON_ONCE(old == ar))
+		return -EEXIST;	/* C1' owns overlap rejection */
+
+	b = corten_slot_bucket(old);
+	if (!b && (!old || old == &corten_va_reserve_sentinel))
+		return xa_err(xa_store(xa, frame, ar, GFP_KERNEL));
+
+	if (!b) {
+		struct corten_arena *first = old;
+
+		nb = kzalloc(struct_size(nb, rec, 2), GFP_KERNEL);
+		if (!nb)
+			return -ENOMEM;
+		nb->nr = 2;
+		if (READ_ONCE(first->start) <= READ_ONCE(ar->start)) {
+			nb->rec[0] = first;
+			nb->rec[1] = ar;
+		} else {
+			nb->rec[0] = ar;
+			nb->rec[1] = first;
+		}
+		ret = xa_err(xa_store(xa, frame,
+				      xa_tag_pointer(nb, CORTEN_SLOT_BUCKET_TAG),
+				      GFP_KERNEL));
+		if (ret)
+			kfree(nb);
+		return ret;
+	}
+
+	n = b->nr + 1;
+	nb = kzalloc(struct_size(nb, rec, n), GFP_KERNEL);
+	if (!nb)
+		return -ENOMEM;
+	nb->nr = n;
+	for (i = 0, j = 0; i < n; i++) {
+		if (!placed && (j >= b->nr ||
+				READ_ONCE(b->rec[j]->start) >
+				READ_ONCE(ar->start))) {
+			nb->rec[i] = ar;
+			placed = true;
+		} else {
+			nb->rec[i] = b->rec[j++];
+		}
+	}
+	ret = xa_err(xa_store(xa, frame,
+			      xa_tag_pointer(nb, CORTEN_SLOT_BUCKET_TAG),
+			      GFP_KERNEL));
+	if (ret) {
+		kfree(nb);
+		return ret;
+	}
+	kfree_rcu(b, rcu);
+	return 0;
+}
+
+/* Drop @ar from @frame's member set (the RELEASE/punch/declare-unwind
+ * publish).  @restore: when @ar is the frame's last member and the
+ * frame sits inside a claimed magazine segment, the slot returns to
+ * the reserve marker instead of empty (the va_release_frame contract);
+ * with co-members present it is ignored -- a marker must never share a
+ * frame with live records.  An already-empty slot is legal (the punch
+ * route erased it first); any other foreign shape is a kernel bug and
+ * WARNs, leaving the slot untouched.  A failed shrink store falls back
+ * to the whole-slot erase: a bucket that names @ar past its free would
+ * be a UAF for every later walk, while a lost co-membership degrades
+ * open (the lookups miss into the legacy funnel) -- the release-side
+ * ENOMEM corner, loudly.
+ */
+static void corten_slot_remove(struct xarray *xa, unsigned long frame,
+			       struct corten_arena *ar, bool restore)
+{
+	struct corten_frame_bucket *b, *nb;
+	void *old = xa_load(xa, frame);
+	unsigned int n, i, j;
+	int ret;
+
+	if (!old)
+		return;		/* already punched away: legal since D-G'' */
+
+	if (old == ar) {
+		if (restore)
+			xa_store(xa, frame, &corten_va_reserve_sentinel,
+				 GFP_KERNEL);
+		else
+			xa_erase(xa, frame);
+		return;
+	}
+
+	b = corten_slot_bucket(old);
+	if (WARN_ON_ONCE(!b))
+		return;		/* foreign marker/record: leave it be */
+
+	n = b->nr;
+	for (i = 0; i < n && b->rec[i] != ar; i++)
+		;
+	if (WARN_ON_ONCE(i == n))
+		return;		/* not a member: kernel bug */
+
+	if (n == 2) {
+		ret = xa_err(xa_store(xa, frame, b->rec[i ^ 1], GFP_KERNEL));
+		if (!ret)
+			kfree_rcu(b, rcu);
+		else
+			xa_erase(xa, frame);	/* the no-dangling fallback */
+		return;
+	}
+
+	nb = kzalloc(struct_size(nb, rec, n - 1), GFP_KERNEL);
+	if (nb) {
+		nb->nr = n - 1;
+		for (i = 0, j = 0; i < nb->nr; i++, j++) {
+			if (b->rec[j] == ar)
+				j++;
+			nb->rec[i] = b->rec[j];
+		}
+		ret = xa_err(xa_store(xa, frame,
+				      xa_tag_pointer(nb, CORTEN_SLOT_BUCKET_TAG),
+				      GFP_KERNEL));
+		if (!ret) {
+			kfree_rcu(b, rcu);
+			return;
+		}
+		kfree(nb);
+	}
+	xa_erase(xa, frame);		/* the no-dangling fallback */
+}
