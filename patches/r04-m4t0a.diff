+		addr2 = round_up(obstacle_end, PMD_SIZE);
+		if (addr2 < obstacle_end ||	/* overflow */
+		    addr2 > CORTEN_MODE_WINDOW_END - len2) {
+			corten_arena_auto_fallback(state);
