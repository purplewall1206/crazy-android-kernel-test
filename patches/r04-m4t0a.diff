+	KUNIT_EXPECT_EQ(test,
+			corten_arena_release_classify(CORTEN_UNMAP_CHUNK, a,
+						      e - PAGE_SIZE, a, e),
+			CORTEN_UNMAP_EXACT);
+	KUNIT_EXPECT_EQ(test,
+			corten_arena_release_classify(CORTEN_UNMAP_CHUNK, a,
+						      e - (2 * PMD_SIZE - PAGE_SIZE),
+						      a, e),
+			CORTEN_UNMAP_EXACT);
+	/* Boundary: a full 2M tail is real chunk territory. */
+	KUNIT_EXPECT_EQ(test,
+			corten_arena_release_classify(CORTEN_UNMAP_CHUNK, a,
+						      e - 2 * PMD_SIZE, a, e),
+			CORTEN_UNMAP_CHUNK);
