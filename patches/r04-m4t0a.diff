+	if (arg3 || arg4 || arg5)
+		return -EINVAL;
+	if (op != CORTEN_MODE_ENTER && op != CORTEN_MODE_EXIT &&
+	    op != CORTEN_MODE_GET)
+		return -EINVAL;
