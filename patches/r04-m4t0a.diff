+int corten_arena_auto_mmap_route(struct mm_struct *mm, unsigned long len,
+				 unsigned long prot, unsigned long *addr,
+				 unsigned long *lenp, unsigned long *flagsp)
+{
+	struct corten_mm_state *state;
+	unsigned long addr2, len2;
