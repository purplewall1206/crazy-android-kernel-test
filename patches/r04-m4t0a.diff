+	KUNIT_EXPECT_EQ(test,
+			corten_arena_release_classify(CORTEN_UNMAP_PARTIAL,
+						      a + PMD_SIZE,
+						      e + PMD_SIZE, a, e),
+			CORTEN_UNMAP_PARTIAL);
+	KUNIT_EXPECT_EQ(test,
+			corten_arena_release_classify(CORTEN_UNMAP_OUTSIDE,
+						      a - PMD_SIZE, a, a, e),
+			CORTEN_UNMAP_OUTSIDE);
