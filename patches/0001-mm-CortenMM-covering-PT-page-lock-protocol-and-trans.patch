+ * and fleshes this out.
+ */
+static struct corten_ptdesc *corten_real_child(void *ctx,
+					       struct corten_ptdesc *parent,
+					       unsigned long addr)
+{
+	WARN_ON_ONCE(1);
+	return ERR_PTR(-EOPNOTSUPP);
