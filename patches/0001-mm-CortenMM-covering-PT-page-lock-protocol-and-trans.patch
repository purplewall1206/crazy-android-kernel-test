+	corten_test_mutex_run(test, c, 8 * PAGE_SIZE,
+			      PMD_SIZE + 8 * PAGE_SIZE);
+
+	KUNIT_EXPECT_EQ(test, atomic_read(&c->violations), 0);
+	KUNIT_EXPECT_GE(test, atomic_read(&c->max_crit), 2);
+}
