+		return -EINVAL;
+	if (unlikely(!len || (len & ~PAGE_MASK)))
+		return -EINVAL;
+	if (unlikely(start & ~PAGE_MASK))
+		return -EINVAL;
+	if (unlikely(check_add_overflow(start, len, &end)))
+		return -EOVERFLOW;
