 	*flagsp |= MAP_FIXED | MAP_NORESERVE;
@@ -1177,8 +1301,15 @@ int corten_arena_auto_attach(struct mm_struct *mm, unsigned long addr,
 	 * run the legacy paths (harmless, counted).
 	 */
 	ret = corten_arena_declare_locked(mm, state, addr, len);
-	if (ret)
+	if (ret) {
