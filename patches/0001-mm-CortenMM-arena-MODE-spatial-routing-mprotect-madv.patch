-			vma = find_vma_intersection(mm, addr2, addr2 + len2);
-			if (vma)
-				obstacle_end = vma->vm_end;
-		}
-
-		if (!obstacle_end)
-			break;
-
-		addr2 = round_up(obstacle_end, PMD_SIZE);
