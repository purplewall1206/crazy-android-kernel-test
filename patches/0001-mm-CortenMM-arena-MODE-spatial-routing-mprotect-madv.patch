+static int corten_arena_test_meta(struct mm_struct *mm, unsigned long addr,
+				  struct corten_pte_meta *out)
+{
+	struct corten_txn txn;
+	int ret;
+
+	ret = corten_lock_range(mm, addr, PAGE_SIZE, &txn);
+	if (ret)
+		return ret;
+	ret = corten_query(&txn, addr, out);
